# ==============================================================================
# TRUSTVAULT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Configuration
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Default for development is local PostgreSQL, or fallback to SQLite for zero-config quick run:
# DATABASE_URL=postgresql://trustvault:trustvault_secret@localhost:5432/trustvault_db
DATABASE_URL=sqlite:///instance/trustvault.db

# Storage Configuration
# Provider: 'local' or 's3'
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25

# Optional S3 Configuration (if STORAGE_PROVIDER=s3)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_BUCKET_NAME=trustvault-private-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# Security & Sessions
SESSION_COOKIE_NAME=trustvault_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=86400

# Rate Limiting
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_AUTH=10 per minute

# Frontend Environment Variables (for frontend/.env)
# VITE_API_BASE_URL=http://localhost:5000/api/v1
